                  "content": "/**\n * Threat Risk Scoring Engine\n *\n * Computes a composite AI risk score (0–100) from five independent signal\n * categories, each normalised to [0, 100] before weighting.\n *\n * Weights\n * ─────────────────────────────────────────────\n *  Severity              25 %   (alert severity level)\n *  Correlation           20 %   (number of correlated events)\n *  Threat Intelligence   25 %   (known IOC / TI feed match confidence)\n *  Behavioural Anomaly   20 %   (deviation score from baseline behaviour)\n *  MITRE ATT&CK Match    10 %   (number of matched ATT&CK techniques)\n * ─────────────────────────────────────────────\n *  Total                100 %\n *\n * Classification bands\n * ─────────────────────────────────────────────\n *   0 – 30   LOW\n *  31 – 60   MEDIUM\n *  61 – 80   HIGH\n *  81 – 100  CRITICAL\n */\n\nexport type SeverityLevel = \"LOW\" | \"MEDIUM\" | \"HIGH\" | \"CRITICAL\";\n\nexport type RiskClassification = \"LOW\" | \"MEDIUM\" | \"HIGH\" | \"CRITICAL\";\n\nexport interface RiskInputs {\n  /** Alert severity level reported by the detection source */\n  severity: SeverityLevel;\n\n  /**\n   * Raw count of events correlated to this alert across all sensors/sources.\n   * Capped internally at 40 for normalisation.\n   */\n  correlatedEvents: number;\n\n  /**\n   * Threat-intelligence match confidence: 0–100.\n   * 0 = no match in any TI feed; 100 = confirmed IOC hit with high confidence.\n   */\n  tiMatchScore: number;\n\n  /**\n   * Behavioural anomaly score: 0–100.\n   * Derived from deviation from a device's rolling baseline (e.g. z-score mapped to 0-100).\n   */\n  behaviourScore: number;\n\n  /**\n   * Number of distinct MITRE ATT&CK (ICS) techniques matched.\n   * Capped internally at 5 for normalisation.\n   */\n  mitreMatchCount: number;\n}\n\nexport interface RiskScoreResult {\n  /** Final composite score, rounded to the nearest integer, clamped [0, 100] */\n  score: number;\n  /** Tier classification based on score bands */\n  classification: RiskClassification;\n  /** Per-factor breakdown for transparency / tooltip display */\n  breakdown: {\n    severityScore: number;\n    correlationScore: number;\n    tiScore: number;\n    behaviourScore: number;\n    mitreScore: number;\n  };\n}\n\n// ── Weights (must sum to 1.0) ──────────────────────────────────────────────\nconst W_SEVERITY    = 0.25;\nconst W_CORRELATION = 0.20;\nconst W_TI          = 0.25;\nconst W_BEHAVIOUR   = 0.20;\nconst W_MITRE       = 0.10;\n\n/** Map a severity label to a normalised 0–100 value. */\nfunction normaliseSeverity(s: SeverityLevel): number {\n  const map: Record<SeverityLevel, number> = {\n    LOW:      20,\n    MEDIUM:   50,\n    HIGH:     80,\n    CRITICAL: 100,\n  };\n  return map[s] ?? 20;\n}\n\n/** Normalise a raw event count to 0–100, capped at maxEvents. */\nfunction normaliseCount(count: number, max: number): number {\n  return Math.min(100, (count / max) * 100);\n}\n\n/** Classify a score into a named risk tier. */\nfunction classify(score: number): RiskClassification {\n  if (score >= 81) return \"CRITICAL\";\n  if (score >= 61) return \"HIGH\";\n  if (score >= 31) return \"MEDIUM\";\n  return \"LOW\";\n}\n\n/**\n * Compute the composite threat risk score from raw signal inputs.\n */\nexport function computeRiskScore(inputs: RiskInputs): RiskScoreResult {\n  const severityScore    = normaliseSeverity(inputs.severity);\n  const correlationScore = normaliseCount(inputs.correlatedEvents, 40);\n  const tiScore          = Math.min(100, Math.max(0, inputs.tiMatchScore));\n  const behaviourScore   = Math.min(100, Math.max(0, inputs.behaviourScore));\n  const mitreScore       = normaliseCount(inputs.mitreMatchCount, 5);\n\n  const raw =\n    severityScore    * W_SEVERITY    +\n    correlationScore * W_CORRELATION +\n    tiScore          * W_TI          +\n    behaviourScore   * W_BEHAVIOUR   +\n    mitreScore       * W_MITRE;\n\n  const score = Math.min(100, Math.max(0, Math.round(raw)));\n\n  return {\n    score,\n    classification: classify(score),\n    breakdown: { severityScore, correlationScore, tiScore, behaviourScore, mitreScore },\n  };\n}\n"
