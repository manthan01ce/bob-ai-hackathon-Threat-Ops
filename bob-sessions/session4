tring(\"en-US\", { weekday: \"short\", day: \"numeric\", month: \"short\", year: \"numeric\" })} &nbsp;\r\n                <span className=\"text-white font-bold text-base\">\r\n                  {new Date().toLocaleTimeString(\"en-US\", { hour12: false, hour: \"2-digit\", minute: \"2-digit\" })}\r\n                </span>\r\n              </div>\r\n            </div>\r\n\r\n            <div className=\"m-stripe\" />\r\n\r\n            {/* KPI CARDS — Threat Intelligence */}\r\n            <div className=\"grid grid-cols-5 gap-3\">\r\n              <ThreatKpiCard\r\n                icon={<Flame size={16} />}\r\n                title=\"Critical Alerts\"\r\n                value={summary?.critical_assets ?? 14}\r\n                accent=\"#e22718\"\r\n                sub=\"Requires immediate action\"\r\n              />\r\n              <ThreatKpiCard\r\n                icon={<AlertTriangle size={16} />}\r\n                title=\"High Risk Alerts\"\r\n                value={summary?.at_risk_assets ?? 37}\r\n                accent=\"#f4b400\"\r\n                sub=\"Elevated threat posture\"\r\n              />\r\n              <ThreatKpiCard\r\n                icon={<Shield size={16} />}\r\n                title=\"Active Threats\"\r\n                value={summary?.critical_assets ? Math.round(summary.critical_assets * 1.8) : 26}\r\n                accent=\"#1c69d4\"\r\n                sub=\"Cross-sensor correlated\"\r\n              />\r\n              <ThreatKpiCard\r\n                icon={<MonitorSmartphone size={16} />}\r\n                title=\"Affected Devices\"\r\n                value={summary?.total_assets ? Math.round(summary.total_assets * 0.12) : 101}\r\n                accent=\"#a855f7\"\r\n                sub=\"Devices under active threat\"\r\n              />\r\n              <ThreatKpiCard\r\n                icon={<GitMerge size={16} />}\r\n                title=\"Correlated Events\"\r\n                value={summary?.critical_assets ? Math.round(summary.critical_assets * 14) : 198}\r\n                accent=\"#0fa336\"\r\n                sub=\"Multi-source event clusters\"\r\n              />\r\n            </div>\r\n\r\n            {/* MIDDLE ROW */}\r\n            <div className=\"grid grid-cols-3 gap-4\">\r\n              {/* MAP */}\r\n              <div className=\"col-span-2 bg-[#1a1a1a] border border-[#3c3c3c] p-4 flex flex-col\" style={{ height: 390 }}>\r\n                <div className=\"flex justify-between items-center mb-3\">\r\n                  <div className=\"flex items-center gap-2\">\r\n                    <h2 className=\"text-sm font-bold uppercase\">Grid Risk Map (Gujarat)</h2>\r\n                    <span className=\"text-[9px] bg-[#222] border border-[#444] px-1.5 py-0.5 text-[#888] uppercase\">\r\n                      MapTiler Dataviz Dark\r\n                    </span>\r\n                  </div>\r\n\r\n                  <div className=\"flex items-center gap-1\">\r\n                    {[\r\n                      { id: \"ALL\", label: \"ALL (836)\" },\r\n                      { id: \"CRITICAL\", label: \"CRITICAL\" },\r\n                      { id: \"POWER_PLANT\", label: \"POWER PLANTS (12)\" },\r\n                      { id: \"SUBSTATION\", label: \"SUBSTATIONS\" },\r\n                      { id: \"TRANSFORMER\", label: \"TRANSFORMERS\" },\r\n                    ].map((ft) => (\r\n                      <button\r\n                        key={ft.id}\r\n                        onClick={() => setFilterType(ft.id)}\r\n                        className={`px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider transition-colors ${\r\n                          filterType === ft.id\r\n                            ? \"bg-[#1c69d4] text-white\"\r\n                            : \"bg-[#111] text-[#888] border border-[#333] hover:text-white\"\r\n                        }`}\r\n                      >\r\n                        {ft.label}\r\n                      </button>\r\n                  